# Foxora — فایل نمونه؛ آن را به .env کپی کنید و مقادیر را پر کنید
# cp .env.example .env
#
# ⚠️ تمام state اجرایی Foxora (session، دیتابیس، تنظیمات runtime، مالک،
# لاگ‌ها، فایل‌های موقت و بکاپ‌ها) در مسیر مستقل ~/.foxora زندگی می‌کند و
# هیچ‌وقت داخل مسیرهای B2 (~/.local/share/soroush-bot*) نوشته نمی‌شود.

# ========= instance (معمولاً خودکار؛ تغییر ندهید) =========
# لانچرهای foxora / foxora.py مقدار foxora را قطعی می‌کنند و فایل نشانگر
# .bot_instance هم همان مقدار را تضمین می‌کند.
# BOT_INSTANCE=foxora

# ========= حالت یوزر-بات (پیشنهادی برای مدیریت گروه) =========
# ورود اولیه: python3 tools/login_primary_once.py — این ابزار نشست را
# *فقط* یک بار تلاش می‌کند و آن را فقط در متغیر اختصاصی زیر ذخیره
# می‌کند؛ به SOROUSH_SESSION_STRING عمومی (نشست B2) دست نمی‌زند.
# متغیر اختصاصی instance اولویت دارد تا session هرگز با B2 قاطی نشود:
SOROUSH_SESSION_STRING_FOXORA=
# fallback عمومی (فقط وقتی متغیر اختصاصی بالا خالی است):
SOROUSH_SESSION_STRING=
# اگر کلید API شخصی دارید (اختیاری، SPlusthon کلید پیش‌فرض دارد)
API_ID=
API_HASH=

# ========= حالت ربات رسمی (جایگزین) =========
BOT_TOKEN=
SOROUSH_BOT_TOKEN=

# ========= مسیر دادهٔ مستقل Foxora =========
# پیش‌فرض: ~/.foxora — فقط در صورت نیاز override کنید.
# SOROUSH_BOT_DATA_DIR_FOXORA=/path/to/foxora-data

# ========= بودجه اتصال مشترک SPlusthon (ارثی از B2) =========
BOT_RPC_GOVERNOR_ENABLED=1
BOT_RPC_GOVERNOR_SHADOW=0
BOT_RPC_TOTAL_LIMIT=3
BOT_RPC_NONCRITICAL_LIMIT=2
BOT_RPC_DELETE_LIMIT=1
BOT_RPC_SEND_LIMIT=2
BOT_RPC_HEAVY_LIMIT=1
BOT_RPC_RESOLVE_LIMIT=1

# ========= صف درخواست‌های گروه‌ها (قابلیت محفوظ Foxora) =========
# یک RPC خروجی در هر لحظه + صف منصفانهٔ محدود + فاصلهٔ بین فراخوان‌ها.
# بازه‌های مجاز: total 1-4096، per-group 1-256، pacing 0-60 ثانیه.
# RPC_MIN_INTERVAL_SECONDS روی مسیر زندهٔ ارسال (RpcGovernor) هم اثر دارد؛
# مقدار 0 رفتار دقیق B2 را حفظ می‌کند.
RPC_MAX_PENDING_TOTAL=256
RPC_MAX_PENDING_PER_GROUP=32
RPC_MIN_INTERVAL_SECONDS=0.25
FAIR_MAX_PENDING_PER_GROUP=16
FAIR_MAX_GROUPS=128

# ========= تأخیر صف‌های هر گروه (ارثی از B2) =========
BOT_MODERATION_PER_CHAT_LIMIT=3
BOT_NORMAL_WORKERS_PER_CHAT=6
# سقف یک job در dispatcher؛ 0 آن را غیرفعال می‌کند.
BOT_DISPATCH_JOB_TIMEOUT_S=90
BOT_SEND_NORMAL_WORKERS_PER_CHAT=1
BOT_SEND_GLOBAL_NORMAL_PENDING=40
BOT_RPC_MAX_SEND_WAITERS=0

# ========= بهینه‌سازی لاگ و CPU (قابلیت محفوظ Foxora) =========
# لاگ‌نویسی نباید ربات را کند کند: صف لاگ bounded است و هنگام اشباع drop
# می‌کند؛ لاگ‌های پرتکرار هر پیام پیش‌فرض سرکوب می‌شوند و چرخش خودکار
# مانع رشد بی‌رویهٔ فایل‌ها می‌شود.
BOT_LOG_MAX_BYTES=20971520
BOT_LOG_BACKUPS=5
# فقط برای دیباگ موقت 1 کنید؛ در تولید 0/خالی بماند.
# BOT_VERBOSE_LOGS=

# ========= ناظر دائمی Crash =========
WATCHDOG_RESTART_DELAY=5
WATCHDOG_MAX_RESTART_DELAY=60
WATCHDOG_STABLE_SECONDS=300
WATCHDOG_REPORT_COOLDOWN=900
WATCHDOG_RAPID_FAILURE_WINDOW=20
WATCHDOG_RAPID_FAILURE_LIMIT=3
WATCHDOG_OWNER_MESSAGE_LIMIT=3500
WATCHDOG_OWNER_TRACEBACK_MAX_CHARS=12000
WATCHDOG_LOG_MAX_BYTES=2097152
WATCHDOG_LOG_BACKUPS=5

# ========= گزارش کندی زنده (بدون spam لاگ) =========
WATCHDOG_SLOW_ALERT_THRESHOLD_MS=1000
WATCHDOG_SLOW_ALERT_INTERVAL_SECONDS=30
WATCHDOG_SLOW_BATCH_INTERVAL_SECONDS=300
WATCHDOG_SLOW_RPC_PRESSURE_LIMIT=8
WATCHDOG_SLOW_QUEUE_SIZE=2

# --- 🖇 فیلتر لینک بیوگرافی (اختیاری) ---
# مستندات کامل: docs/BIO_LINK_FILTER.md
# سیاست پیش‌فرض: فقط کاربرانی که در گروه پیام می‌دهند بررسی می‌شوند.
# BIO_LINK_DEFAULT_ENABLED=1
# BIO_LINK_DETECT_USERNAME=0
# BIO_LINK_TTL_SECONDS=21600
# BIO_LINK_AWAIT_FIRST_CHECK=1
# BIO_LINK_AWAIT_TIMEOUT=8
# BIO_LINK_AUTO_SCAN_MEMBERS=0
# BIO_LINK_SCAN_LIMIT=200
# BIO_LINK_SCAN_BUDGET=120
# BIO_LINK_RPC_DELAY=0.4
# BIO_LINK_FETCH_TIMEOUT=20
# BIO_LINK_START_DELAY=120
# BIO_LINK_CHECK_ON_MESSAGE=1
# BIO_LINK_CHECK_ON_JOIN=1
# BIO_LINK_SKIP_NATIVE_ADMINS=1
# BIO_LINK_MAX_PENDING=400

# ========= مهلت RPC، FloodWait و رصد awaitها (رفع کندی ارسال) =========
# مهلت صریح و طبقهبندیشده برای هر RPC؛ دیگر 60s سراسری وجود ندارد.
BOT_RPC_SEND_TIMEOUT_S=15
BOT_RPC_MODERATION_TIMEOUT_S=20
BOT_RPC_READ_TIMEOUT_S=20
# ResolveUsername (برای @username) نباید بیشتر از چند ثانیه معطل بماند.
BOT_RPC_RESOLVE_TIMEOUT_S=8
BOT_RPC_TIMEOUT_S=60
# 0 = SPlusthon داخل _call نخوابد؛ FloodWait به لایه بکآف ما پاس داده شود.
BOT_RPC_FLOOD_SLEEP_THRESHOLD_S=0
# تعداد تلاش مجدد پس از FloodWait؛ خوابها async و بیرون از gate/governor هستند.
BOT_RPC_FLOOD_MAX_RETRIES=2
BOT_RPC_FLOOD_BACKOFF_BASE_S=0.75
BOT_RPC_FLOOD_BACKOFF_CAP_S=30
BOT_RPC_FLOOD_WAIT_CAP_S=30
BOT_RPC_FLOOD_JITTER_S=0.35
# جداسازی کامل اعلانهای خودکار از پیامهای اصلی (صف/گیت/سطل جداگانه)
BOT_RPC_NOTICE_LIMIT=1
BOT_SEND_NOTICE_WORKERS_PER_CHAT=1
# یک اسلات رزرو برای RPCهای P0 (EditBanned / GetDifference).
BOT_RPC_CRITICAL_RESERVE=1
# watchdog مستقل Governor؛ بعد از deadline تسک RPC را cancel و permit را آزاد می‌کند.
BOT_RPC_GOVERNOR_WATCHDOG_S=90
BOT_RPC_GOVERNOR_WATCHDOG_GRACE_S=0.25
# watchdog: هر AWAIT START که بعد از deadline + grace جفت نشد، لاگ و کنسل میشود.
BOT_RPC_WATCHDOG_INTERVAL_S=2
BOT_RPC_WATCHDOG_GRACE_S=5
BOT_RPC_WATCHDOG_CANCEL=1
# هر AWAIT START دقیقاً یک خط پایانی RESPONSE/TIMEOUT/ERROR/CANCELLED میگیرد.
BOT_RPC_TRACE_ALL=1
BOT_RPC_TRACE_SLOW_MS=2000
