# ============================================
# تنظیمات ربات Foxora2 (سروش پلاس)
# این فایل را به .env کپی کنید و مقادیر را پر کنید:
#   cp .env.example .env
# ============================================

# --- شناسهٔ مستقل این ربات (Foxora2) ---
# داده‌ها، دیتابیس، لاگ‌ها و تنظیمات در ~/.foxora2 ذخیره می‌شوند
# و هیچ اشتراکی با ربات‌های دیگر (Foxora یا B2) ندارند.
BOT_INSTANCE=foxora2

# --- نشست اختصاصی Foxora2 (روش اصلی: SPlusthon / یوزر-بات) ---
# یک رشتهٔ طولانی که با ابزار زیر یک‌بار ساخته و فقط در همین متغیر ذخیره می‌شود:
#   python3 tools/login_primary_once.py
# ⚠️ حتماً از حساب سروش جدا از ربات Foxora و B2 استفاده کنید.
SOROUSH_SESSION_STRING_FOXORA2=

# (اختیاری) کتابخانهٔ SPlusthon به‌طور پیش‌فرض مقادیر رسمی کلاینت سروش‌پلاس را در
# SoroushClient(StringSession()) دارد و نیازی به وارد کردن دستی API_ID و API_HASH نیست.
# تنها در صورت نیاز به override سفارشی، هر دو متغیر زیر را با هم مقداردهی کنید:
# API_ID_FOXORA2=
# API_HASH_FOXORA2=

# --- روش جایگزین: ربات رسمی (Bot API از طریق @MrBot) ---
BOT_TOKEN_FOXORA2=
SOROUSH_BOT_TOKEN_FOXORA2=

# --- مسیر دادهٔ اختصاصی (اختیاری؛ پیش‌فرض: ~/.foxora2) ---
# SOROUSH_BOT_DATA_DIR_FOXORA2=/custom/path/for/foxora2

# --- 🖇 فیلتر لینک بیوگرافی (اختیاری؛ هیچ‌کدام اجباری نیست) ---
# مستندات کامل: docs/BIO_LINK_FILTER.md
# پیش‌فرض گروه‌های بدون تنظیم: روشن. برای خاموش کردن پیش‌فرض مقدار 0 بگذارید.
# BIO_LINK_DEFAULT_ENABLED=1
# آیا «@username» تنها در بیو هم لینک حساب شود؟ (پیش‌فرض: خیر)
# BIO_LINK_DETECT_USERNAME=0
# فاصلهٔ تازه‌سازی وضعیت هر کاربر (ثانیه) و فاصلهٔ دورهای اسکن
# BIO_LINK_TTL_SECONDS=21600
# BIO_LINK_SCAN_INTERVAL=21600
# سقف اعضا در هر دور اسکن + بودجهٔ زمانی + فاصلهٔ بین درخواست‌ها
# BIO_LINK_SCAN_LIMIT=200
# BIO_LINK_SCAN_BUDGET=120
# BIO_LINK_RPC_DELAY=0.4
# BIO_LINK_FETCH_TIMEOUT=20
# BIO_LINK_START_DELAY=120
# BIO_LINK_CHECK_ON_MESSAGE=1
# اولین پیام هر کاربر منتظر بررسی بیو بماند؟ (پیش‌فرض: بله) + سقف انتظار
# BIO_LINK_AWAIT_FIRST_CHECK=1
# BIO_LINK_AWAIT_TIMEOUT=8
# اسکن دوره‌ای «همهٔ اعضا» — پیش‌فرض خاموش؛ فقط کاربران پیام‌دهنده بررسی می‌شوند
# BIO_LINK_AUTO_SCAN_MEMBERS=0
# BIO_LINK_CHECK_ON_JOIN=1
# BIO_LINK_MAX_PENDING=400

# ========= مهلت RPC، FloodWait و رصد awaitها (رفع کندی ارسال) =========
# فاصله‌گذاری مصنوعی بین شروع RPCها خاموش است؛ Governor همچنان فعال می‌ماند.
RPC_MIN_INTERVAL_SECONDS=0.0
# مهلت صریح و طبقهبندیشده برای هر RPC؛ دیگر 60s سراسری وجود ندارد.
BOT_RPC_SEND_TIMEOUT_S=15
BOT_RPC_MODERATION_TIMEOUT_S=20
BOT_RPC_READ_TIMEOUT_S=20
BOT_RPC_TIMEOUT_S=60
# Adaptive delete cap; at Foxora2 total_limit=2 this remains 1.
BOT_RPC_DELETE_LIMIT=auto
# 0 = SPlusthon داخل _call نخوابد؛ FloodWait به لایه بکآف ما پاس داده شود.
BOT_RPC_FLOOD_SLEEP_THRESHOLD_S=0
# تعداد تلاش مجدد پس از FloodWait؛ خوابها async و بیرون از gate/governor هستند.
BOT_RPC_FLOOD_MAX_RETRIES=2
BOT_RPC_FLOOD_BACKOFF_BASE_S=0.75
BOT_RPC_FLOOD_BACKOFF_CAP_S=30
BOT_RPC_FLOOD_WAIT_CAP_S=30
BOT_RPC_FLOOD_JITTER_S=0.35
# جداسازی کامل اعلانهای خودکار از پیامهای اصلی (صف/گیت/سطل جداگانه)
BOT_RPC_NOTICE_LIMIT=1
BOT_SEND_NOTICE_WORKERS_PER_CHAT=1
# اختیاری: رزرو یک اسلات فقط برای RPCهای P0 (EditBanned / GetDifference)
BOT_RPC_CRITICAL_RESERVE=0
# watchdog: هر AWAIT START که بعد از deadline + grace جفت نشد، لاگ و کنسل میشود.
BOT_RPC_WATCHDOG_INTERVAL_S=2
BOT_RPC_WATCHDOG_GRACE_S=5
BOT_RPC_WATCHDOG_CANCEL=1
# هر AWAIT START دقیقاً یک خط پایانی RESPONSE/TIMEOUT/ERROR/CANCELLED میگیرد.
BOT_RPC_TRACE_ALL=1
BOT_RPC_TRACE_SLOW_MS=2000

# ========= ⚖️ دادگاه روباه — قاضی داخلی (بدون هوش مصنوعی) =========
# داوری این بازی کاملن داخل خود ربات انجام می‌شود (تحلیل شواهد متن پرونده).
# هیچ کلید API و هیچ سرویس بیرونی لازم نیست؛ پس این بخش هیچ متغیری ندارد.
#
# دادهٔ دائمی بازی به‌صورت پیش‌فرض در ~/.foxora2/court_game ذخیره می‌شود
# (جدا از Foxora و B2). برای مسیر دلخواه:
# COURT_GAME_DATA_DIR=/path/to/court_game

# ========= 🦊 ضد کانال و بیوگرافی (modules/profile_guard) =========
# شناسایی کانالِ متصل به پروفایل (GetFullUser → personal_channel_id) و
# جمله‌های فیلترشدهٔ بیوگرافی. فهرست‌ها در config/profile_channel_names.txt
# و config/profile_bio_sentences.txt هستند (بدون ری‌استارت هم اعمال می‌شوند).
# عمر اسنپ‌شات پروفایل (ثانیه) — هر کاربر در این بازه فقط یک RPC می‌خورد.
# ۶۰ = بیوگرافی عملاً همیشه چک می‌شود ولی RPC هر کاربر به یک‌بار در دقیقه
# محدود می‌ماند. کاربرِ سابقه‌دار (سکوت گرفته) همیشه با پروفایلِ تازه
# بررسی می‌شود، مستقل از این مقدار.
PROFILE_GUARD_TTL=60
# حداکثر عمرِ «شاهد» برای مجازات (ثانیه)؛ کهنه‌تر ⇒ تازه‌سازی یا صرف‌نظر:
PROFILE_GUARD_FRESH=120
# مدت سکوت برای تخلفِ «جملهٔ بیوگرافی» (پیش‌فرض ۴ ساعت):
PROFILE_GUARD_BIO_MUTE=14400
# فاصلهٔ حداقلی بین RPCها (ثانیه) و تایم‌اوت هر RPC:
PROFILE_GUARD_RPC_MIN_INTERVAL=0.35
PROFILE_GUARD_FETCH_TIMEOUT=12
# مکث پس از خطا برای همان کاربر (ثانیه):
PROFILE_GUARD_ERROR_RETRY=1800
# فاصلهٔ حداقلی بین دو تلاشِ «اعمالِ دوبارهٔ سکوتِ دائمی» برای یک کاربر (ثانیه):
PROFILE_GUARD_REHEAL_INTERVAL=60
# پنهان‌سازیِ مقدارهای حساس در کارتِ هشدار (نام کانال / جملهٔ فیلتر / تعداد اعضا):
#   spoiler = فقط entity اسپویلر (با ضربه باز می‌شود)  [پیش‌فرض]
#   mask    = خودِ متن با «••••••» جایگزین می‌شود (در هر کلاینتی پنهان است)
#   both    = ماسک + اسپویلر
PROFILE_GUARD_HIDE=spoiler
