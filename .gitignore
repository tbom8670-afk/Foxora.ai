# Python runtime artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*$py.class
.pytest_cache/
.mypy_cache/

# Runtime logs and client sessions
logs/
*.session
*.session-*
*.log

# فایل env واقعی — هرگز commit نشود
.env
.env.*
!.env.example

# Runtime state — متعلق به ~/.foxora روی هر دستگاه است، نه مخزن.
# deployment configها (config.json/owner.json/whitelist.txt/banned_words.txt)
# عمداً در مخزن می‌مانند چون کد آن‌ها را از ریشهٔ پروژه می‌خواند.
config/*.json
!config/config.json
!config/owner.json

# runtime files
backups/runtime/
config/tmp*.tmp

# .bot_instance برای Foxora عمداً commit می‌شود: identity همین مخزن است.

# ⚖️ دادگاه روباه — دادهٔ اجرایی پرونده‌ها (نه مخزن؛ ساختار پوشه می‌ماند)
data/court_game/cases/*
data/court_game/sessions/*
data/court_game/ai_logs/*
data/court_game/results/*
!data/court_game/*/.gitkeep
